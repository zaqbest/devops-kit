# devops-kit default configuration
# Override by setting DEVOPS_KIT_CONFIG=/path/to/your.env before running init.sh

# ── Admin user ─────────────────────────────────────────────────────────────────
ADMIN_USER="login01"
ADMIN_SSH_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE7JOcmAqpaiZWKBziJvrr9j7cAD1h5ZyvOdT0DJbNhF"          # SSH public key string; if empty, password is prompted

# ── System ─────────────────────────────────────────────────────────────────────
HOSTNAME_DESIRED=""       # Leave empty to keep current hostname
TIMEZONE="UTC"
LOCALE="en_US.UTF-8"

# ── Swap ───────────────────────────────────────────────────────────────────────
SWAP_ENABLED=1
SWAP_MAX_GB=8             # Cap: swap never exceeds this regardless of RAM

# ── SSH ────────────────────────────────────────────────────────────────────────
SSH_PORT=22
SSH_DISABLE_ROOT=1
SSH_DISABLE_PASSWORD_AUTH=1   # Auto-set to 0 if no ADMIN_SSH_KEY is provided

# ── Firewall ───────────────────────────────────────────────────────────────────
UFW_ALLOWED_TCP_PORTS="22 80 443"
UFW_ALLOWED_UDP_PORTS=""

# ── Fail2ban ───────────────────────────────────────────────────────────────────
FAIL2BAN_ENABLED=1
FAIL2BAN_MAXRETRY=5
FAIL2BAN_BANTIME=3600     # seconds

# ── Auto-updates ───────────────────────────────────────────────────────────────
AUTO_UPDATES_ENABLED=1

# ── Kernel tuning ──────────────────────────────────────────────────────────────
SYSCTL_TUNING_ENABLED=1
